<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avaloniaIcon="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:sukiui="clr-namespace:SukiUI.Controls;assembly=SukiUI"
             xmlns:pg="clr-namespace:Yuzu_Frontend.Models.PropertyGrid;assembly=Yuzu_Frontend"
             x:Class="Yuzu_Frontend.Desktop.Views.SftpFileManagerView"
             x:Name="Root"
             x:DataType="pg:SftpFileManagerViewModel">

    <Border Padding="24">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16">
            <StackPanel Grid.Row="0" Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Background="{DynamicResource PrimaryBrush}" Opacity="0.2" Padding="8" CornerRadius="8">
                        <avaloniaIcon:MaterialIcon Kind="Server" Width="24" Height="24" Foreground="{DynamicResource PrimaryBrush}" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="SFTP 文件管理" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="连接远程服务器并管理备份文件" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <Border Height="1" Background="{DynamicResource DividerBrush}" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="{Binding ConnectionStatus}" FontSize="12" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ConnectButton"
                                Command="{Binding ConnectCommand}"
                                IsEnabled="{Binding CanConnect}"
                                Classes="Flat Rounded"
                                Height="34"
                                FontSize="13">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <avaloniaIcon:MaterialIcon Kind="Plug" Width="16" Height="16" />
                                <TextBlock Text="连接" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DisconnectButton"
                                Command="{Binding DisconnectCommand}"
                                Classes="Flat Rounded"
                                Height="34"
                                FontSize="13">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <avaloniaIcon:MaterialIcon Kind="Close" Width="16" Height="16" />
                                <TextBlock Text="断开" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TestButton"
                                Command="{Binding TestConnectionCommand}"
                                IsEnabled="{Binding !IsConnecting}"
                                Classes="Flat Rounded"
                                Height="34"
                                FontSize="13">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <avaloniaIcon:MaterialIcon Kind="Check" Width="16" Height="16" />
                                <TextBlock Text="测试连接" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="12">
                <StackPanel Spacing="12">
                    <TextBlock Text="远程文件列表" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Text="{Binding CurrentRemotePath}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>

                <sukiui:GlassCard Grid.Row="1" Padding="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding RemoteFiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="pg:SftpFileItem">
                                    <Border Padding="8" Cursor="Hand" PointerPressed="Border_PointerPressed">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                            <avaloniaIcon:MaterialIcon Width="20" Height="20" Kind="{Binding IconKind}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                                <Button x:Name="DownloadButton"
                                                        Command="{Binding #Root.DataContext.DownloadCommand}"
                                                        CommandParameter="{Binding}"
                                                        IsVisible="{Binding !IsDirectory}"
                                                        Width="28" Height="28"
                                                        Classes="Flat Rounded">
                                                    <avaloniaIcon:MaterialIcon Kind="Download" Width="14" Height="14" />
                                                </Button>
                                                <Button x:Name="DeleteButton"
                                                        Command="{Binding #Root.DataContext.DeleteCommand}"
                                                        CommandParameter="{Binding}"
                                                        Width="28" Height="28"
                                                        Classes="Flat Rounded">
                                                    <avaloniaIcon:MaterialIcon Kind="Trash" Width="14" Height="14" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </sukiui:GlassCard>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button x:Name="UploadButton"
                        Command="{Binding UploadCommand}"
                        IsEnabled="{Binding CanUpload}"
                        Classes="Flat Rounded"
                        Height="34"
                        FontSize="13">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <avaloniaIcon:MaterialIcon Kind="Upload" Width="16" Height="16" />
                        <TextBlock Text="上传文件" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="TransferStatus" Text="{Binding TransferProgress}" FontSize="12" 
                           VerticalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
