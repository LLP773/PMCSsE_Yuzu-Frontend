<Project>
  <!-- https://learn.microsoft.com/en-us/nuget/consume-packages/central-package-management -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Avalonia packages -->
    <!-- Important: keep version in sync! -->
    <PackageVersion Include="Avalonia" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Diagnostics" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageVersion Include="Avalonia.iOS" Version="12.1.0" />
    <PackageVersion Include="Avalonia.Browser" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Android" Version="12.1.0" />
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <PackageVersion Include="PMCSsE_Communicator" Version="1.0.4.3" />
    <PackageVersion Include="ProDataGrid" Version="12.0.4" />
    <PackageVersion Include="Google.Protobuf" Version="3.34.1" />
    <PackageVersion Include="Grpc.Tools" Version="2.80.0" />
    <PackageVersion Include="Material.Icons.Avalonia" Version="3.0.2" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="LightProto" Version="1.3.4" />
    <PackageVersion Include="protobuf-net" Version="3.3.8" />
    <PackageVersion Include="protobuf-net.Core" Version="3.2.56" />
    <PackageVersion Include="ReactiveUI.Avalonia" Version="12.1.1" />
    <PackageVersion Include="ReactiveUI.Fody" Version="12.1.1" />
    <PackageVersion Include="SukiUI" Version="7.0.1" />
    <PackageVersion Include="SukiUI.Dock" Version="7.0.1" />
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="System.Reactive" Version="7.0.0" />
    <!-- CodeWF 日志核心库：提供 UserLogEntry 数据模型 + LogType 枚举 + Logger 静态日志能力（纯 DTO，无 UI，AOT 安全） -->
    <PackageVersion Include="CodeWF.Log.Core" Version="12.1.0.16" />
    <!-- CodeWF 日志查看控件：基于 Avalonia 的 LogView，内置级别颜色、虚拟化滚动、自动刷新 -->
    <PackageVersion Include="CodeWF.LogViewer.Avalonia" Version="12.1.0.16" />
    <!-- CodeWF.LogViewer.Avalonia 传递依赖：Xaml.Behaviors 用于通知动画行为 -->
    <PackageVersion Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.2.0.3" />
    <!-- Roslyn / Source Generator 依赖 -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" />
  </ItemGroup>
</Project>