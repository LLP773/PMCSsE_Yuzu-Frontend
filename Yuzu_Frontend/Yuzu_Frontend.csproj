<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BaseOutputPath>.\..\生成\Yuzu_Frontend</BaseOutputPath>
    <Version>1.0.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <!-- ===== AOT 兼容性静态分析 ===== -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <!-- AotMode（Desktop 发布 Native AOT 时透传）下开启完整 AOT 分析；常规构建保持 false -->
    <IsAotCompatible Condition="'$(IsAotCompatible)' == '' AND '$(AotMode)' == 'true'">true</IsAotCompatible>
    <IsAotCompatible Condition="'$(IsAotCompatible)' == ''">false</IsAotCompatible>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  
  <ItemGroup>
    <AvaloniaXaml Remove="Controls\**" />
    <AvaloniaXaml Remove="Styles\**" />
    <Compile Remove="Controls\**" />
    <Compile Remove="Styles\**" />
    <EmbeddedResource Remove="Controls\**" />
    <EmbeddedResource Remove="Styles\**" />
    <None Remove="Controls\**" />
    <None Remove="Styles\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Include="Material.Icons.Avalonia" />
    <PackageReference Include="PMCSsE_Communicator" />
    <PackageReference Include="ReactiveUI.Avalonia" />
    <PackageReference Include="SukiUI" />
    <PackageReference Include="SukiUI.Dock" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="protobuf-net" />
    <PackageReference Include="SSH.NET" />
    <PackageReference Include="System.Reactive" />
  </ItemGroup>

  <ItemGroup>
    <!-- Source Generator：编译期生成 PropertyGrid 静态分类与 ViewLocator 映射（AOT 安全） -->
    <ProjectReference
      Include="..\Yuzu_Frontend.SourceGenerators\Yuzu_Frontend.SourceGenerators.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
      SetTargetFramework="TargetFramework=netstandard2.0" />
  </ItemGroup>

  <PropertyGroup>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)\Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
</Project>
